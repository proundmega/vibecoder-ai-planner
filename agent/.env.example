# Vibecode AI Agent - Required Environment Variables

# Backend API authentication
AGENT_API_KEY=your-agent-api-key

# Backend API URL
BACKEND_URL=http://localhost:3001

# Project to work on
PROJECT_ID=1

# GitHub repository
REPO_OWNER=myorg
REPO_NAME=myrepo

# GitHub credentials: app = repo-scoped installation token from the backend (default)
# pat = explicit local-development fallback; requires ALLOW_PAT=true on backend and agent
GITHUB_AUTH_MODE=app
ALLOW_PAT=false
# Optional dev-only fallback used only in pat mode
# GITHUB_TOKEN=ghp_...

# Optional: AI Provider Configuration
AI_PROVIDER=claude
AI_MODEL=claude-sonnet-4-20250514
AI_API_KEY=your-ai-api-key

# Optional: Agent Behavior
POLL_INTERVAL_MS=30000
STALE_TIMEOUT_MS=3600000
DRY_RUN=false
MAX_TICKETS=1

# Optional: OpenCode harness (fg-30)
# legacy = one-shot JSON file operations (default); opencode = server-driven coding harness
HARNESS_MODE=legacy
HARNESS_BIN=opencode
HARNESS_STARTUP_TIMEOUT_MS=30000
HARNESS_MAX_DURATION_MINUTES=45
# Semicolon-separated commands; empty = autodetect from package.json/pom.xml/Makefile.
# If nothing is detected the ticket fails closed (no unverified publish).
HARNESS_VERIFY_COMMANDS=
# Semicolon-separated globs the supervisor refuses to publish
HARNESS_PROTECTED_PATHS=.env*;**/.env*;Jenkinsfile;**/Jenkinsfile;.github/**;**/.github/**;**/secrets/**
# Optional model override, e.g. opencode-go/beam-free. The provider prefix, if
# present, must match the configured provider type.
HARNESS_MODEL=
# Publishing guard limits
HARNESS_MAX_FILES=50
HARNESS_MAX_LINES=2000
HARNESS_MAX_BYTES=5242880
# Set false to skip the full git fsck scan on very large repositories
HARNESS_FSCK=true
# Failure backoff (prevents the 30s poll loop from re-running the same ticket).
# After HARNESS_RETRY_PIN_ATTEMPTS, the run is marked dead_letter and the
# ticket is left in_progress for operator recovery; no further automatic retry.
# HARNESS_MAX_ATTEMPTS is accepted as a legacy alias.
HARNESS_RETRY_PIN_ATTEMPTS=3
HARNESS_RETRY_BASE_DELAY_MS=60000
HARNESS_RETRY_MAX_DELAY_MS=3600000

# Optional: sandbox for repo-controlled commands (fg-34)
# host   = run on the supervisor (current Phase 1 behaviour; NOT a security
#          boundary; local development only)
# docker = disposable hardened container for supervisor-driven install and
#          verification commands. Do NOT use for untrusted repos until D14
#          (the best-effort descendant sweep fork race) is closed.
#          In slice 2 the OpenCode bash tool is bridged into the same sandbox
#          (built-in bash is disabled; the model uses the sandbox_bash tool).
SANDBOX_MODE=host
# Build from agent/sandbox.Dockerfile, or point at a repo-specific image.
# Base images are digest-pinned; run agent/scripts/sandbox-image-security.sh
# --check-pins. Production should pin these built images by digest too.
SANDBOX_IMAGE=vibecode-agent-sandbox:latest
# Image used for the egress allowlist proxy. Keep this as a dedicated trusted
# image (agent/sandbox-proxy.Dockerfile), not the repo-specific sandbox image,
# so a repository cannot alter the proxy runtime.
SANDBOX_PROXY_IMAGE=vibecode-sandbox-proxy:latest
SANDBOX_DOCKER_BIN=docker
# Refuse to start unless the sandbox is Docker (use in production).
SANDBOX_REQUIRE=false
# Host mode only: fail fast when SecureDirectoryStream is unavailable instead
# of using the non-atomic fallback. Strict true/1 or false/0.
SANDBOX_REQUIRE_SECURE_FILE_ACCESS=false
SANDBOX_CPUS=2.0
SANDBOX_MEMORY_MB=2048
SANDBOX_PIDS=512
# Workspace quota. A supervisor watchdog runs for the sandbox lifetime and
# kills the container when the bind-mounted workspace exceeds this; 0 disables
# it. --ulimit fsize guards a single file and --storage-opt (when
# SANDBOX_DISK_ENFORCE=true) is defense-in-depth for the container layer, not
# the bind mount. Unlinked-but-open files are outside the supervisor walk
# (fg-34 D12).
SANDBOX_DISK_MB=5120
SANDBOX_DISK_CHECK_INTERVAL_SECONDS=10
SANDBOX_DISK_ENFORCE=false
SANDBOX_NOFILE=1024
SANDBOX_TMPFS_MB=256
# "none" (default deny) or "allowlist". With "allowlist", the sandbox joins
# an internal Docker network whose only peer is a hardened egress proxy; it has
# no default route, so clearing HTTP_PROXY does not bypass the allowlist.
# External DNS is disabled (the proxy is addressed by IP), so DNS cannot be
# used for exfiltration. The proxy validates the first CONNECT ClientHello SNI
# and rejects multiple SNI names/extra handshakes and CONNECT :80; TLS
# renegotiation and the encrypted inner Host remain D16. Denied requests are
# logged by the supervisor when the sandbox is destroyed.
SANDBOX_NETWORK=none
# Comma/semicolon separated hostnames, e.g.
# registry.npmjs.org,*.githubusercontent.com,repo.maven.apache.org
# Wildcards are allowed only as a leading "*.". IP literals, localhost,
# private names and metadata hosts are rejected.
SANDBOX_ALLOWED_HOSTS=
# Reserved: the built-in proxy is used instead. Setting this fails closed.
SANDBOX_EGRESS_PROXY=
# Docker network the proxy uses for upstream access (default: bridge).
SANDBOX_EGRESS_UPSTREAM_NETWORK=bridge
# How long the proxy waits for the first TLS ClientHello before denying the
# tunnel. Raise it for slow-but-legitimate clients (default: 5000ms).
SANDBOX_EGRESS_PROBE_TIMEOUT_MS=5000
# Non-secret test configuration only; secret-looking keys (including *_KEY,
# *_TOKEN, *_SECRET and scheme-less user:pass@host URLs) are rejected.
# Example: SANDBOX_ENV=CI=1;FEATURE_FLAG=on
SANDBOX_ENV=
# Defaults to the supervisor uid:gid so the workspace stays writable.
SANDBOX_USER=
# Root is refused unless SANDBOX_ALLOW_ROOT=true (not recommended).
SANDBOX_ALLOW_ROOT=false
SANDBOX_EXEC_TIMEOUT_SECONDS=900
# Bounds putFile/getFile artifacts; downloads are size-checked inside the
# container before docker cp. Command output is bounded separately by the exec
# output cap.
SANDBOX_ARTIFACT_MAX_BYTES=5242880
# Optional host security profiles (paths/names must exist on the daemon host).
SANDBOX_SECCOMP_PROFILE=
SANDBOX_APPARMOR_PROFILE=
# Docker mode requires a manually run host agent (or a path mapping): the
# Docker daemon resolves bind mounts on the host, not inside the agent
# container. PoolManager/compose wiring is deferred to fg-34 D8.
SANDBOX_CONTAINER_WORKSPACE_ROOT=/repos
SANDBOX_HOST_WORKSPACE_ROOT=
