# Remote host template (fg-54): runs the supervisor against a backend that is
# NOT on this Compose network. Copy this file, fill the values, and run:
#   docker compose -f docker-compose.remote.yml up -d
#
# Do not commit a filled copy: it contains a one-time join token.
services:
  supervisor:
    image: ${AGENT_IMAGE:-vibecode-agent:latest}
    environment:
      - SUPERVISOR_CONFIG=/config/agent.ini
      - AGENT_JAR=/app/agent.jar
      - BACKEND_URL=${BACKEND_URL:?set BACKEND_URL, e.g. https://planner.example.com}
      # First boot only: the credential volume is the node identity after that.
      # Leave this set in .env (harmless once a credential file exists) or
      # remove it; an image update or reboot works without a token.
      - ENROLLMENT_TOKEN=${ENROLLMENT_TOKEN:-}
      - ENROLLMENT_URL=${ENROLLMENT_URL:-}
      - AGENT_CREDENTIALS_FILE=/credentials/node.json
      - AGENT_NODE_NAME=${AGENT_NODE_NAME:-}
      # Only for plain-HTTP backends on a non-loopback host (dev/LAN testing).
      - ALLOW_INSECURE_AGENT_ENROLLMENT=${ALLOW_INSECURE_AGENT_ENROLLMENT:-0}
      - AGENT_RUNTIME_HEAP_MB=${AGENT_RUNTIME_HEAP_MB:-768}
      - SUPERVISOR_MEMORY_BUDGET_MB=${SUPERVISOR_MEMORY_BUDGET_MB:-0}
      - SUPERVISOR_STOP_TIMEOUT_SECONDS=${SUPERVISOR_STOP_TIMEOUT_SECONDS:-10}
      - AGENT_HOST_MAX_RUNTIMES=${AGENT_HOST_MAX_RUNTIMES:-50}
      - AGENT_DISK_BUDGET_GB=${AGENT_DISK_BUDGET_GB:-}
      - HARNESS_WORKSPACE_RETENTION_HOURS=${HARNESS_WORKSPACE_RETENTION_HOURS:-24}
      # fg-58: storage lifecycle. The supervisor refreshes idle runtimes,
      # samples disk and inodes, sweeps old roots/orphans and prunes images.
      - AGENT_IDLE_REFRESH_MS=${AGENT_IDLE_REFRESH_MS:-7200000}
      - AGENT_MAX_LIFETIME_HOURS=${AGENT_MAX_LIFETIME_HOURS:-24}
      - AGENT_STORAGE_CHECK_SECONDS=${AGENT_STORAGE_CHECK_SECONDS:-60}
      - AGENT_STORAGE_METER_SECONDS=${AGENT_STORAGE_METER_SECONDS:-300}
      - AGENT_STORAGE_WARN_PCT=${AGENT_STORAGE_WARN_PCT:-70}
      - AGENT_STORAGE_STOP_PCT=${AGENT_STORAGE_STOP_PCT:-80}
      - AGENT_STORAGE_CLEAN_PCT=${AGENT_STORAGE_CLEAN_PCT:-85}
      - AGENT_STORAGE_RECYCLE_PCT=${AGENT_STORAGE_RECYCLE_PCT:-90}
      - AGENT_STORAGE_MANUAL_PCT=${AGENT_STORAGE_MANUAL_PCT:-95}
      - AGENT_STORAGE_MAX_INODES=${AGENT_STORAGE_MAX_INODES:-0}
      - AGENT_ORPHAN_TTL_HOURS=${AGENT_ORPHAN_TTL_HOURS:-24}
      - AGENT_IMAGE_PRUNE_ENABLED=${AGENT_IMAGE_PRUNE_ENABLED:-true}
      - AGENT_IMAGE_PRUNE_TIMEOUT_SECONDS=${AGENT_IMAGE_PRUNE_TIMEOUT_SECONDS:-30}
      # Optional fallback only; the project's configured repo wins.
      - REPO_OWNER=${REPO_OWNER:-}
      - REPO_NAME=${REPO_NAME:-}
      - REPO_CLONE_DIR=/repos
      - AI_PROVIDER=${AI_PROVIDER:-claude}
      - AI_MODEL=${AI_MODEL:-claude-sonnet-4-20250514}
    volumes:
      # Declared runtimes only: no keys or tokens.
      - ${AGENT_INI_PATH:-./agent.ini}:/config/agent.ini:ro
      # Credentials are written as the agent user (uid 100); the image owns
      # /credentials so a fresh named volume inherits that ownership.
      - agent_credentials:/credentials
      # Worker clones land here. The host directory must be writable by uid
      # 100, gid 101: mkdir -p repos && sudo chown 100:101 repos
      - ${REPO_HOST_PATH:-./repos}:/repos
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: ${AGENT_LOG_MAX_SIZE:-10m}
        max-file: ${AGENT_LOG_MAX_FILE:-3}
    deploy:
      resources:
        limits:
          memory: ${SUPERVISOR_MEMORY_LIMIT:-2G}
          cpus: '${SUPERVISOR_CPUS:-2.0}'

volumes:
  # Keep this volume: deleting it loses the node identity and requires a new
  # join token.
  agent_credentials:
