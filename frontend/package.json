{
  "name": "@vibecode/frontend",
  "version": "1.0.0",
  "description": "Kanban AI Planner Frontend",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "generate:api": "openapi-typescript-codegen --input ../backend/src/api/openapi-generated.json --output src/api/generated --exportServices true",
    "generate:spec": "cd ../backend && npm run generate:spec",
    "cypress:open": "cypress open",
    "cypress:component": "cypress run --component --browser chrome",
    "cypress:e2e": "cypress run --e2e --browser chrome --headless",
    "cypress:all": "cypress run --component --browser chrome && cypress run --e2e --browser chrome --headless"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.6.2",
    "diff": "^9.0.0",
    "diff2html": "^3.4.56",
    "pinia": "^2.1.7",
    "vue": "^3.3.11",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@cypress/vue": "^4.2.2",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.11",
    "cypress": "^15.16.0",
    "cypress-localstorage-commands": "^2.3.0",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^29.1.1",
    "openapi-typescript-codegen": "^0.30.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.8",
    "vitest": "^1.1.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.0.0"
  }
}
