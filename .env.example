# Vibecode Environment Configuration (example)
# Copy this file to .env.local and edit it:
#   cp .env.example .env.local
#   docker compose --env-file .env.local up --build
# .env and .env.local are gitignored; never commit real secrets.

POSTGRES_PASSWORD=changeme
JWT_SECRET=super-secret-key-change-in-production-use-envsubst
PGADMIN_PASSWORD=changeme
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
