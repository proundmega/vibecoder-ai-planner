# Vibecode Environment Configuration (example)
# Copy this file to .env.local and edit it:
#   cp .env.example .env.local
#   docker compose --env-file .env.local up --build
# .env and .env.local are gitignored; never commit real secrets.

POSTGRES_PASSWORD=changeme
JWT_SECRET=super-secret-key-change-in-production-use-envsubst
PGADMIN_PASSWORD=changeme
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# fg-45 readiness gate: off | warn | enforce. warn audits blocked attempts but
# allows the transition; enforce returns 409 READINESS_FAILED.
READINESS_GATE_MODE=warn
# Minutes between waiver-expiry sweeps; 0 disables the sweep.
READINESS_SWEEP_INTERVAL_MINUTES=60

# fg-39 FR3: digest-pinned prebuilt stack images proposed by stack detection.
# Build with `agent/scripts/build-sandbox-images.sh`, publish, then map each
# stack key to its @sha256 reference (JSON on one line). Keys: node, python,
# java, go, monorepo. Leave empty to require the admin to enter an image.
# REPO_PROFILE_STACK_IMAGES={"node":"registry.example/vibecode-sandbox-node:latest@sha256:...","python":"registry.example/vibecode-sandbox-python:latest@sha256:..."}

# fg-32b1: fix-request claim lease in seconds (60..86400).
# Backend fallback only: the agent always sends a lease derived from
# FIX_MAX_DURATION_MINUTES (+10 min).
FIX_LEASE_TTL_SECONDS=1800
