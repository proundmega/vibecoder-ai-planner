{
  "name": "@vibecode/backend",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "db:migrate": "node src/migrations/apply.js",
    "db:reset": "node src/migrations/apply.js",
    "test:integration": "jest --config jest.integration.config.js --passWithNoTests",
    "generate:spec": "node -e \"const specs = require('./src/api/openapi-spec'); require('fs').writeFileSync('./src/api/openapi-generated.json', JSON.stringify(specs, null, 2));\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.1",
    "@octokit/rest": "^20.0.2",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dockerode": "^5.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "ioredis": "^5.4.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "openai": "^4.20.1",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "slugify": "^1.6.6",
    "ssh2": "^1.17.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
