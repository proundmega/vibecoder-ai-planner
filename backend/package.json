{
  "name": "@vibecode/backend",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "db:migrate": "node src/migrations/apply.js",
    "db:reset": "node src/migrations/apply.js",
    "test:integration": "jest --config jest.integration.config.js --passWithNoTests",
    "generate:spec": "node -e \"const specs = require('./src/api/openapi-spec'); require('fs').writeFileSync('./src/api/openapi-generated.json', JSON.stringify(specs, null, 2));\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@octokit/rest": "^20.1.2",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dockerode": "^5.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "openai": "^6.48.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "slugify": "^1.6.6",
    "ssh2": "^1.17.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.7.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
