# Environment Configuration

# Backend - Development
NODE_ENV=development
PORT=3001
JWT_SECRET=super-secret-key-change-in-production-use-envsubst
TOKEN_EXPIRY_HOURS=24

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibecode
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_MAX_USES=10000

# Request Timeout
REQUEST_TIMEOUT_MS=30000
SLOW_REQUEST_THRESHOLD_MS=5000

# API
VITE_API_URL=http://localhost:3001

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://app.vibecode.ai
