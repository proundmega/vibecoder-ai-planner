# Environment Configuration

# Backend - Development
NODE_ENV=development
PORT=3001
JWT_SECRET=super-secret-key-change-in-production-use-envsubst
TOKEN_EXPIRY_HOURS=24

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibecode
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_MAX_USES=10000

# Request Timeout
REQUEST_TIMEOUT_MS=30000
SLOW_REQUEST_THRESHOLD_MS=5000

# API
VITE_API_URL=http://localhost:3001

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://app.vibecode.ai

# Docker (production: http://docker-proxy:2375, dev: /var/run/docker.sock)
DOCKER_API_URL=http://docker-proxy:2375

# Agent enrollment (fg-53). Explicit opt-in; dev Compose sets true, production false.
AGENT_ENROLLMENT_ENABLED=false
# Only set when the API is behind a trusted reverse proxy (Express trust proxy).
# Without it, X-Forwarded-Proto is ignored and req.secure stays false.
# 1 = one trusted hop; true = trust every hop (only on a private proxy network);
# or pass an IP/CIDR list.
# TRUST_PROXY=1
# Join/access/refresh lifetimes
AGENT_ENROLLMENT_TOKEN_TTL_SECONDS=900
AGENT_ACCESS_TOKEN_TTL_SECONDS=3600
AGENT_REFRESH_TOKEN_TTL_DAYS=30
AGENT_REFRESH_REPLAY_CACHE_SECONDS=60
# Refuse non-TLS enrollment except loopback. Local testing only:
ALLOW_INSECURE_AGENT_ENROLLMENT=0
# Retention for expired/revoked credentials and auth events
AGENT_TOKEN_RETENTION_DAYS=30
AGENT_AUTH_EVENT_RETENTION_DAYS=180

# Encryption (required: 64 hex characters for AES-256)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GitHub credentials (fg-35)
# app = repo-scoped GitHub App installation tokens (production default)
# pat = explicit local-development fallback; requires ALLOW_PAT=true on the backend and agent
GITHUB_AUTH_MODE=app
ALLOW_PAT=false
GITHUB_APP_ID=
# PEM value, \n-escaped PEM, or file:/run/secrets/github-app.pem
GITHUB_APP_PRIVATE_KEY=
# Single-tenant/dev fallback when a project has no mapping row
GITHUB_APP_INSTALLATION_ID=
GITHUB_TOKEN_TTL_SECONDS=3600

# Redis (optional in dev with in-memory fallback)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=vibecode:

# Response validation (optional: enables response schema validation in production)
RESPONSE_VALIDATION=false
