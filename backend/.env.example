# Environment Configuration

# Backend - Development
NODE_ENV=development
PORT=3001
JWT_SECRET=super-secret-key-change-in-production-use-envsubst
TOKEN_EXPIRY_HOURS=24

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibecode
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_MAX_USES=10000

# Request Timeout
REQUEST_TIMEOUT_MS=30000
SLOW_REQUEST_THRESHOLD_MS=5000

# API
VITE_API_URL=http://localhost:3001

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://app.vibecode.ai

# Docker (production: http://docker-proxy:2375, dev: /var/run/docker.sock)
DOCKER_API_URL=http://docker-proxy:2375

# Encryption (required: 64 hex characters for AES-256)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GitHub credentials (fg-35)
# app = repo-scoped GitHub App installation tokens (production default)
# pat = explicit local-development fallback; requires ALLOW_PAT=true on the backend and agent
GITHUB_AUTH_MODE=app
ALLOW_PAT=false
GITHUB_APP_ID=
# PEM value, \n-escaped PEM, or file:/run/secrets/github-app.pem
GITHUB_APP_PRIVATE_KEY=
# Single-tenant/dev fallback when a project has no mapping row
GITHUB_APP_INSTALLATION_ID=
GITHUB_TOKEN_TTL_SECONDS=3600

# Redis (optional in dev with in-memory fallback)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=vibecode:

# Response validation (optional: enables response schema validation in production)
RESPONSE_VALIDATION=false
